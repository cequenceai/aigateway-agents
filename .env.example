# API Keys for AI Agents
# Copy this file to .env and fill in your actual API keys
# The .env file is gitignored, so your keys won't be committed

# Anthropic API Key (for Anthropic Agent and Langchain Agent with Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (for OpenAI Agent and Langchain Agent with OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI Model Override
# OPENAI_MODEL=gpt-4o

# MCP Server Configuration
# MCP_SERVER_URL=https://your-mcp-server.com/mcp
# MCP_TARGET_IDENTIFIER=your_target_identifier_here

# Optional: Tavily API Key (for enhanced web search in Langchain Agent)
# TAVILY_API_KEY=your_tavily_api_key_here
