# API Keys for AI Agents
# DO NOT COMMIT THIS FILE - It contains sensitive API keys
# Copy this file to .env and fill in your actual API keys

# Anthropic API Key (for Anthropic Agent and Langchain Agent with Anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (for OpenAI Agent and Langchain Agent with OpenAI)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MCP Server Configuration
MCP_URL=https://ztaid-stkaeb2t-e4l2dawa5a-uc.a.run.app/mcp

# Slack Configuration
# Target channel ID for Slack messaging (e.g., D025N5FN3RT for a DM)
# Leave blank to use default or specify in task
SLACK_CHANNEL_ID=

# Code of Conduct / Safety Instructions
# These are automatically applied to all agents to prevent unwanted behavior
# See AGENT_CODE_OF_CONDUCT.md for full details

# Safety Instructions - Prevents unwanted interactions
SAFETY_INSTRUCTIONS=IMPORTANT: This is for testing/proof of concept only. You MUST operate in local mode (only interact with myself). Do NOT post in public. Do NOT message others. Do NOT bother others. Do NOT interact with others. Only interact with the user/owner of this system.

# User Search Restriction - Prevents agents from searching for users to message
NO_USER_SEARCH=Do NOT use tools to search for users, find users, or list users. Do NOT message anyone except the specified channel ID.

# Profile Creation Restriction - Prevents creating new entities
NO_PROFILE_CREATION=CRITICAL: Do NOT create profiles, users, guest accounts, or any new user entities. Do NOT use tools that create users, profiles, or accounts. Only interact with existing users/channels that are explicitly provided.

# Optional: Tavily API Key (for enhanced web search in Langchain Agent)
# TAVILY_API_KEY=your_tavily_api_key_here
