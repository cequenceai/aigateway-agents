# API Keys
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to git - it's in .gitignore

# Anthropic API Key (for Claude)
# Format: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-api03-xx.xxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xx.xxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Tavily API Key (for web search)
# TAVILY_API_KEY=your-tavily-api-key-here

# MCP Server Configuration (optional - can be passed via CLI)
# MCP_SERVER_URL=https://your-mcp-server.com/mcp
# MCP_TARGET_IDENTIFIER=your-target-channel-or-user-id

# OpenAI Model Selection (optional)
# OPENAI_MODEL=gpt-4o
