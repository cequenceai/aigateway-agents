# Agent Safety Constraints and Instructions
# This file contains universal constraints for any MCP server
# to prevent unwanted behavior (e.g., posting in public, messaging others)

# Interaction Scope (choose one or combine)
# Options: "local", "only interact with myself", "private", "test environment"
INTERACTION_SCOPE="local"
INTERACTION_DESCRIPTION="only interact with myself"

# Safety Instructions - Universal for any MCP server
# Prevents: public posts, messaging others, bothering others, unwanted interactions
SAFETY_INSTRUCTIONS="IMPORTANT: This is for testing/proof of concept only. You MUST operate in local mode (only interact with myself). Do NOT post in public. Do NOT message others. Do NOT bother others. Do NOT interact with others. Only interact with the user/owner of this system."

# Task Completion Instructions
TASK_COMPLETION="CRITICAL: You must actually COMPLETE the task, not just start it. The task is only complete when you have successfully executed the final action (e.g., sent the message, posted the content, completed the operation). You may need to do multiple steps (find user, get information, send message, etc.) - do ALL of them. Only report completion when the task is truly finished. If you need to search for information or interact with tools multiple times, do so until the task objective is achieved."

# Target Identifier (MCP server specific - e.g., channel ID, user ID, etc.)
# For Slack: D025N5FN3RT (DM channel)
# For other MCP servers: adjust as needed
TARGET_IDENTIFIER="D025N5FN3RT"
TARGET_DESCRIPTION="direct message channel"

# Agent Identification Requirements
AGENT_IDENTIFICATION="When posting messages or providing output, always prefix with your agent name (e.g., 'Anthropic Agent: ', 'Langchain Agent: ', 'OpenAI Agent: ') followed by your message."

# Response Constraints
RESPONSE_LENGTH="Keep your response short and concise."
RESPONSE_SCOPE="Limit your output so only the user can view it for personal understanding and learning."

# Additional Universal Constraints
NO_PUBLIC_POSTS="Do not post in public channels, public spaces, or public forums."
NO_OTHER_USERS="Do not message others, do not bother others, do not interact with others."
LOCAL_ONLY="Operate in local/private mode only. All interactions should be with the system owner/user only."

# Profile/User Creation Restrictions
NO_PROFILE_CREATION="CRITICAL: Do NOT create profiles, users, guest accounts, or any new user entities. Do NOT use tools that create users, profiles, or accounts. Only interact with existing users/channels that are explicitly provided (e.g., channel ID D025N5FN3RT)."
NO_USER_MANAGEMENT="Do NOT create, modify, or manage user accounts, profiles, or guest access. Do NOT use any user creation or profile management tools."

# Combined Safety Template (use this in tasks)
# Format: {BASE_TASK} to ${TARGET_DESCRIPTION} ${TARGET_IDENTIFIER}. ${SAFETY_INSTRUCTIONS} ${NO_PUBLIC_POSTS} ${NO_OTHER_USERS} ${LOCAL_ONLY} ${AGENT_IDENTIFICATION} ${RESPONSE_LENGTH} ${RESPONSE_SCOPE} Thank you.
