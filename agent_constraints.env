# Agent Safety Constraints and Instructions
# This file contains constraints that should be included in all agent tasks
# to prevent unwanted behavior (e.g., posting in public channels)

# Channel Restrictions
CHANNEL_ID=D025N5FN3RT
CHANNEL_TYPE=DM
CHANNEL_DESCRIPTION=direct message channel

# Safety Instructions (append to all tasks)
SAFETY_INSTRUCTIONS=IMPORTANT: This is for testing/proof of concept only. You MUST post ONLY to this DM channel (${CHANNEL_ID}). Do NOT post to any public channels, general channels, or other channels.

# Agent Identification Requirements
AGENT_IDENTIFICATION=When posting messages or providing output, always prefix with your agent name (e.g., 'Anthropic Agent: ', 'Langchain Agent: ', 'OpenAI Agent: ') followed by your message.

# Response Constraints
RESPONSE_LENGTH=Keep your response short and concise.
RESPONSE_SCOPE=Limit your output so only the user can view it for personal understanding and learning.

# Combined Safety Template (use this in tasks)
# Format: {BASE_TASK} to channel ${CHANNEL_ID} (${CHANNEL_TYPE} only - this is a ${CHANNEL_DESCRIPTION}). ${SAFETY_INSTRUCTIONS} ${AGENT_IDENTIFICATION} ${RESPONSE_LENGTH} ${RESPONSE_SCOPE} Thank you.

# Example full task template:
# TASK_TEMPLATE="Make a short post about color to channel ${CHANNEL_ID} (${CHANNEL_TYPE} only - this is a ${CHANNEL_DESCRIPTION}). ${SAFETY_INSTRUCTIONS} ${AGENT_IDENTIFICATION} ${RESPONSE_LENGTH} ${RESPONSE_SCOPE} Thank you."
